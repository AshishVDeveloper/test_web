# Only needed on an Apache server (XAMPP/WAMP). GitHub Pages ignores this file and uses 404.html.
# Lets short links work:  /test_web/<token>  and  /test_web/generate
RewriteEngine On

# Real files/folders (images, css...) are served directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# /<game>.php  ->  games/<game>.html, e.g. snake.php, sudoku.php, snake-multy.php
# (redirect, so the game's own links still work; only if that game page exists)
RewriteCond %{REQUEST_FILENAME} ^(.*/)([^/]+)\.php$
RewriteCond %1games/%2.html -f
RewriteCond %{REQUEST_URI} ^(.*/)([^/]+)\.php$
RewriteRule ^([A-Za-z0-9_\-]+)\.php$ %1games/$1.html [R=302,L]

# /generate  ->  generate.html
RewriteRule ^generate/?$ generate.html [L,QSA]

# Everything else: /<token>  ->  index.html (the page reads the token from the address)
RewriteRule ^([A-Za-z0-9_\-\.]+)/?$ index.html [L,QSA]
